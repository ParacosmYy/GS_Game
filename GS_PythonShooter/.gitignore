# GS_PythonShooter — Git 忽略规则

# ─── 虚拟环境（必须忽略） ──────────────────────────────
.venv/
venv/
env/

# ─── Python 缓存 ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# ─── IDE ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── 项目临时文件 ──────────────────────────────────────
test_output.log
*.db

# ─── 系统文件 ───────────────────────────────────────────
Thumbs.db
.DS_Store
