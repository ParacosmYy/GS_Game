{
  "name": "kof2002",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "vitest run tests/constantsConsistency.test.ts tests/commandBuffer.test.ts tests/airborneActionRouting.test.ts tests/fighterStateIntegrity.test.ts",
    "test:ryo": "vitest run tests/ryo*.test.ts",
    "test:combat": "vitest run tests/combat*.test.ts tests/cancel*.test.ts tests/hit*.test.ts tests/guard*.test.ts tests/juggle*.test.ts",
    "test:content": "vitest run tests/*Manifest*.test.ts tests/*FrameData*.test.ts tests/ryoFrameContract.test.ts",
    "test:full": "vitest run",
    "test:watch": "vitest",
    "tools:validate:ryo": "npx tsx src/tools/validateManifest.ts ryo",
    "tools:report:ryo": "npx tsx src/tools/ryoCompletenessReport.ts",
    "tools:authenticity:ryo": "npx tsx src/tools/ryoAuthenticityCheck.ts"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
